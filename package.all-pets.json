    "src/renderer/all-pets-control.js",
    "src/renderer/inactivity-settings.html",
    "src/renderer/inactivity-settings.css",
    "src/renderer/inactivity-settings.js",
    "src/renderer/styles.css",
    "android/all-pets-apk/app/src/main/assets/**/*",
